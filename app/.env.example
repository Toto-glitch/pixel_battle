# Uvicorn settings
APP__UC__HOST=localhost
APP__UC__PORT=8000
APP__UC__RELOAD=1

# Database connection settings. Use your values
APP__DB__HOST=...
APP__DB__PORT=5432
APP__DB__USER=...
APP__DB__PASSWORD=...
APP__DB__NAME=...

# Redis connection settings. Use your values
APP__REDIS__HOST=...
APP__REDIS__PORT=6379
APP__REDIS__DB=0

# JWT settings. Use your values
# You can use command "python -c 'import secrets; print(secrets.token_hex(32))'" to generate secret key
APP__JWT__SECRET_KEY=...
APP__JWT__ALGORITHM=HS256
APP__JWT__ACCESS_TOKEN_EXPIRE_MINUTES=30

# Pixel canvas settings
APP__CANVAS__WIDTH=100
APP__CANVAS__HEIGHT=100
APP__CANVAS__COOLDOWN_SECONDS=5
